# Export these variables in your shell or hosting environment.
PORT=3100
HOST=127.0.0.1
DATABASE_PATH=./data/chamber.sqlite
# Firebase Admin SDK (optional). Create a service account in Firebase Console.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project.iam.gserviceaccount.com
# Store the private key as one line with newlines encoded as \n.
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Set for a production HTTPS deployment:
# NODE_ENV=production
# APP_ORIGIN=https://your-domain.example
# Configure Resend to enable staff password recovery email:
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_FROM=Chamber <accounts@your-verified-domain.example>
